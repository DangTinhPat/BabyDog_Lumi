<?xml version="1.0"?>
<!-- Top-level entry point for the physical structure, ros2_control and the
     Gazebo IMU sensor. The real MPU6050 follows a dedicated /imu/raw ->
     imu_kalman_filter -> /imu/data topic path rather than a ros2_control sensor
     interface; the same filter consumes /imu/sim_raw in simulation. -->
<robot name="babydog" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find main_bot)/description/babydog.xacro"/>
  <xacro:include filename="$(find main_bot)/description/babydog.ros2_control.xacro"/>
  <xacro:include filename="$(find main_bot)/description/sensors/imu.xacro"/>

</robot>
