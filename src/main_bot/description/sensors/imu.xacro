<?xml version="1.0"?>
<!-- Gazebo counterpart of the real MPU6050 mounted on imu_link. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu/sim_raw</topic>
      <pose>0 0 0 0 0 0</pose>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.08</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.08</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.08</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
