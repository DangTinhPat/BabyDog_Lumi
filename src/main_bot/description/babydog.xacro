    <self_collide>1</self_collide>
  </gazebo>
  <gazebo reference="hind_right_foot">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
    <kp value="300000.0"/>
    <kd value="10000.0"/>
  </gazebo>
  <!-- HL leg -->
  <gazebo reference="hind_left_abad_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="hind_left_hip_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
