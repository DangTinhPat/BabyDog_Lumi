<?xml version="1.0"?>
<!-- Physical structure only (links/joints/meshes/materials/friction) - KHÔNG còn
     <ros2_control> ở đây, xem babydog.ros2_control.xacro (tách riêng theo convention
     ros2_control thường thấy: robot.urdf.xacro / robot.ros2_control.xacro /
     robot.gazebo.xacro). Sensor <gazebo> blocks live in description/sensors/*.xacro;
     tất cả các file này được kéo vào bởi description/robot.urdf.xacro.

     Physical structure is the AlphaDog "devq" quadruped (source:
     https://github.com/AlphaDogDeveloper/dev_robot_control_sdk,
     resources/devq/urdf/devq.urdf) - same geometry vendored from the
     superDog sim project (this is the real hardware target: RDK X3 +
     STM32H7 over FDCAN). Per-leg joint naming is abad(roll)/hip(pitch)/
     knee(pitch), same 3-DOF-per-leg structure as Go1's hip/thigh/calf, just
     renamed - see controllers.yaml's joints/feet_names lists (base_name:
     "base" is the dummy root link below). No IMU sensor interface yet (real
     robot doesn't have one wired up yet either) - see sensors/imu.xacro,
     currently unused; re-add its include in robot.urdf.xacro plus the
     imu_sensor <ros2_control> block (babydog.ros2_control.xacro) once the
     real IMU is wired to the STM32. -->
<robot name="babydog" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.9137254901960784 0.9137254901960784 0.8470588235294118 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4235294117647059 0.0392156862745098 1.0"/>
  </material>
  <material name="brown">
    <color rgba="0.8705882352941177 0.8117647058823529 0.7647058823529411 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <gazebo reference="base">
    <material>Gazebo/Green</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
  <gazebo reference="body">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp value="1000000.0"/>
    <kd value="1.0"/>
  </gazebo>
  <gazebo reference="imu_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/Red</material>
  </gazebo>
  <!-- Per-leg friction/contact. Non-foot links use the same conservative
       default (mu 0.2) as the original Go1 links - devq.urdf gives no
       friction data for them. Foot links use devq.urdf's own <contact>
       block (lateral_friction/stiffness/damping), which is a
       PyBullet/MuJoCo-style extension gz's URDF loader ignores, so it's
       translated here into gz's mu1/mu2/kp/kd equivalents instead. Note
       lateral_friction=6.0 is high relative to Go1's foot mu=0.6 - kept as
       given since it's the source model's explicit intent, but worth
       watching for excessive stick/grip during walking tuning. -->
  <!-- FR leg -->
  <gazebo reference="front_right_abad_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="front_right_hip_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="front_right_knee_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
  </gazebo>
  <gazebo reference="front_right_foot">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
    <kp value="300000.0"/>
    <kd value="10000.0"/>
  </gazebo>
  <!-- FL leg -->
  <gazebo reference="front_left_abad_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="front_left_hip_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="front_left_knee_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
  </gazebo>
  <gazebo reference="front_left_foot">
