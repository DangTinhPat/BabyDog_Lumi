    <self_collide>1</self_collide>
    <kp value="300000.0"/>
    <kd value="10000.0"/>
  </gazebo>
  <link name="base">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>
