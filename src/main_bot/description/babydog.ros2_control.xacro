      </xacro:if>
    </joint>
    <joint name="hind_left_knee_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
        <state_interface name="visual_position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="visual_velocity"><param name="initial_value">0.0</param></state_interface>
      </xacro:if>
    </joint>
    <!-- IMU deliberately is not a ros2_control state interface. Both branches
         publish sensor data through imu_kalman_filter on /imu/data, keeping the
         real MPU6050 and Gazebo path identical above their raw transports. -->
  </ros2_control>

  <!-- Chi Gazebo doc block nay (moi hardware khac im lang bo qua the <gazebo> khong
       hieu) - gz_ros2_control's plugin tu doc controllers.yaml + host controller_manager
       ben trong process Gazebo. Voi hardware:=real, real_ros2_control.launch.py khong
       goi gz_sim nen block nay khong duoc dung toi, nhung vo hai neu con trong URDF. -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find main_bot)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
