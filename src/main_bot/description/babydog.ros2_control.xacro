<?xml version="1.0"?>
<!-- ros2_control interface definition ONLY - tách riêng khỏi babydog.xacro (vật lý:
     link/joint/mesh/material/friction) theo đúng convention hay thấy ở các dự án
     ros2_control khác (robot.urdf.xacro / robot.ros2_control.xacro / robot.gazebo.xacro
     tách biệt). Kéo vào bởi robot.urdf.xacro, không tự đứng riêng được (tham chiếu tên
     joint định nghĩa trong babydog.xacro bằng string, không cần thứ tự include cụ thể -
     URDF/ros2_control không yêu cầu <joint> phải đứng trước <ros2_control> tham chiếu nó). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- "gazebo" (mac dinh, dung boi sim.launch.py) hoac "real" (dung boi
       real_ros2_control.launch.py, main_bot_hardware/RealSystem) - xem
       <hardware> ben duoi. Khong doi gi cho hardware_target="gazebo", output
       xacro y het truoc khi co xacro:arg nay. -->
  <xacro:arg name="hardware" default="gazebo"/>
  <xacro:property name="hardware_target" value="$(arg hardware)"/>

  <!-- gz sim's ros2_control integration. initial_value on each position
       state_interface = 0.0 for every joint - matches the calibrated "home"
       pose (nam xap/prone, see NOTE.md muc 2.6 "DA FIX VINH VIEN"): origin
       rpy trong babydog.xacro (hip/knee) da duoc dich chuyen sao cho gia tri
       khop = 0.0 CHINH LA tu the nghi tu nhien, va nam trong <limit> hop le
       (knee's limit hien la lower="-2.269" upper="0.0" - 0.0 la bien tren hop
       le, KHONG con bi loai tru nhu truoc). TRUOC DAY gia tri nay hardcode
       theo pose Stand cu (-0.748/1.495) vi luc do 0 nam NGOAI limit khop goi
       (lower="0.436" cu) - da lac hau tu khi hieu chinh origin/limit, gay
       robot spawn sai dang (chan xoe ngang) du code KHONG lien quan gi den
       cac thay doi khac - PHAI giu dung 0.0 o day, khong tu y doi initial state
       theo target Stand trong tuong lai. effort la command_interface cho
       hardware_target=gazebo only - it's what leg_pd_controller (the
       low-level layer of the vendored gait stack) actually claims;
       hardware_target=real exports position/velocity/kp/kd/effort commands instead (matches
       main_bot_hardware/RealSystem::export_command_interfaces()). "effort" tren real la Tff
       trong cung khung PD, khong phai effort-only mode. RealSystem also exports
       visual_position/visual_velocity state interfaces that retain the last finite
       feedback for TF only; raw position/velocity still become NaN on invalid feedback. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <xacro:if value="${hardware_target == 'gazebo'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <plugin>main_bot_hardware/RealSystem</plugin>
      </xacro:if>
    </hardware>
    <joint name="front_right_abad_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
        <state_interface name="visual_position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="visual_velocity"><param name="initial_value">0.0</param></state_interface>
      </xacro:if>
    </joint>
    <joint name="front_right_hip_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
        <state_interface name="visual_position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="visual_velocity"><param name="initial_value">0.0</param></state_interface>
      </xacro:if>
    </joint>
    <joint name="front_right_knee_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
        <state_interface name="visual_position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="visual_velocity"><param name="initial_value">0.0</param></state_interface>
      </xacro:if>
    </joint>
    <joint name="front_left_abad_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
        <state_interface name="visual_position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="visual_velocity"><param name="initial_value">0.0</param></state_interface>
      </xacro:if>
    </joint>
    <joint name="front_left_hip_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
        <state_interface name="visual_position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="visual_velocity"><param name="initial_value">0.0</param></state_interface>
      </xacro:if>
    </joint>
    <joint name="front_left_knee_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
        <state_interface name="visual_position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="visual_velocity"><param name="initial_value">0.0</param></state_interface>
      </xacro:if>
    </joint>
    <joint name="hind_right_abad_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
        <state_interface name="visual_position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="visual_velocity"><param name="initial_value">0.0</param></state_interface>
      </xacro:if>
    </joint>
    <joint name="hind_right_hip_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
        <state_interface name="visual_position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="visual_velocity"><param name="initial_value">0.0</param></state_interface>
      </xacro:if>
    </joint>
    <joint name="hind_right_knee_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
        <state_interface name="visual_position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="visual_velocity"><param name="initial_value">0.0</param></state_interface>
      </xacro:if>
    </joint>
    <joint name="hind_left_abad_joint">
      <xacro:if value="${hardware_target == 'gazebo'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <xacro:if value="${hardware_target == 'real'}">
        <command_interface name="effort"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="velocity"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kp"><param name="initial_value">0.0</param></command_interface>
        <command_interface name="kd"><param name="initial_value">0.0</param></command_interface>
      </xacro:if>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${hardware_target == 'real'}">
